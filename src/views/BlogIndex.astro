---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bar from "../components/Bar.astro";
import Arrow from "../components/Arrow.astro";
import { useT, type Lang } from "../i18n";
import { getPosts, postSlug, postUrl, formatDate } from "../lib/blog";

interface Props { lang: Lang; alternates: { ca: string; es: string } }
const { lang, alternates } = Astro.props;
const { t } = useT(lang);
const posts = await getPosts(lang);
---
<BaseLayout lang={lang} title={t("blog.seo.titol")} description={t("blog.seo.descripcio")} alternates={alternates} actiu="blog">
  <section class="mx-auto max-w-site px-5 pb-20 pt-12 sm:px-8 lg:pb-24 lg:pt-16 xl:px-20">
    <div class="drawbar mb-7 h-1.5 w-14 bg-groc" aria-hidden="true"></div>
    <h1 class="h-display rise mb-5 text-[clamp(32px,4vw,50px)] leading-[1.05]">{t("blog.titol")}</h1>
    <p class="rise mb-12 max-w-[720px] text-xl leading-normal" style="--d:.15s">{t("blog.intro")}</p>
    <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(320px,100%),1fr))] gap-8">
      {posts.map((post, i) => (
        <li class="reveal" style={`--d:${(i % 3) * 0.1}s`}>
          <a href={postUrl(lang, postSlug(post))} class="group flex h-full flex-col bg-white no-underline shadow-[0_1px_0_rgba(20,20,20,.04)] transition-shadow duration-300 hover:shadow-[0_12px_30px_rgba(20,20,20,.10)]">
            {post.data.imatge && (
              <div class="aspect-[3/2] overflow-hidden bg-sand">
                <img src={post.data.imatge} alt="" loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <span class="mb-2 text-[15px] text-ink-soft">{formatDate(post.data.data, lang)}</span>
              <h2 class="mb-3 font-display text-[21px] font-extrabold leading-tight">{post.data.titol}</h2>
              <p class="mb-5 text-[17px] leading-normal text-ink-soft">{post.data.descripcio}</p>
              <span class="link-arrow mt-auto inline-flex items-center gap-2 font-bold">{t("blog.llegeix")} <Arrow size={18} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
