---
import { useT, negoci, type Lang } from "../i18n";
import Button from "./Button.astro";
import MapaZona from "./MapaZona.astro";

interface Props { lang: Lang; alternates: { ca: string; es: string } }
const { lang, alternates } = Astro.props;
const { t, h, r } = useT(lang);

const nav = [
  { href: r("inici"), label: t("comu.nav.inici") },
  { href: r("comTreballo"), label: t("comu.nav.comTreballo") },
  { href: r("inici", "serveis"), label: t("comu.peu.serveis") },
  { href: r("consulta"), label: t("comu.nav.consulta") },
  { href: r("comTreballo", "sobre-mi"), label: t("comu.peu.sobreMi") },
  { href: r("inici", "ressenyes"), label: t("comu.peu.ressenyes") },
  { href: r("inici", "faq"), label: t("comu.peu.faq") },
  { href: r("bici"), label: t("comu.peu.bici") },
  { href: r("domicili"), label: t("comu.peu.domicili") },
  { href: r("blog"), label: t("comu.nav.blog") },
];
const legal = [
  { href: r("avisLegal"), label: t("comu.peu.avisLegal") },
  { href: r("privacitat"), label: t("comu.peu.privacitat") },
  { href: r("cookies"), label: t("comu.peu.cookies") },
];
---
<footer id="contacte" class="relative mt-5 bg-night text-white">
  <img src="/img/belianes-bn.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 size-full object-cover object-[center_30%]" />
  <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(90deg,rgba(43,43,42,.88)_0%,rgba(43,43,42,.45)_45%,rgba(20,20,20,.88)_100%)]"></div>

  <div class="relative mx-auto flex max-w-site flex-wrap items-center justify-between gap-10 px-5 py-14 sm:px-8 xl:px-20">
    <div class="reveal">
      <p class="h-display mb-8 text-[clamp(36px,4.4vw,64px)] leading-none" set:html={h("comu.peu.titol")} />
      <Button href={negoci.whatsapp} variant="blanc">{t("comu.peu.boto")}</Button>
      <p class="mt-6 text-lg">
        <a href={`tel:${negoci.telefon}`} class="inline-flex min-h-11 items-center gap-2 font-bold !text-white no-underline">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
          {negoci.telefonVisible}
        </a>
      </p>
    </div>
    <MapaZona lang={lang} variant="fosc" class="reveal w-full max-w-[420px] flex-[0_1_420px]" />
    <div class="text-[19px] uppercase leading-tight">
      <p class="mb-4 text-2xl leading-[1.1]" set:html={h("comu.peu.nom")} />
      <div class="mb-4 h-px w-16 bg-white"></div>
      <p set:html={h("comu.peu.lema")} />
    </div>
  </div>

  <nav aria-label={t("comu.peu.mapaWeb")} class="relative mx-auto flex max-w-site flex-wrap gap-x-8 gap-y-1 border-t border-white/25 px-5 py-6 pb-28 text-[15px] font-semibold sm:px-8 lg:pb-6 xl:px-20">
    {nav.map((l) => <a href={l.href} class="inline-flex min-h-11 items-center !text-white no-underline hover:underline">{l.label}</a>)}
    <a href={negoci.whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center !text-groc no-underline hover:underline">{t("comu.peu.whatsapp")}</a>
    {legal.map((l) => <a href={l.href} class="inline-flex min-h-11 items-center !text-mute no-underline hover:underline">{l.label}</a>)}
    <span class="inline-flex min-h-11 items-center gap-3 !text-mute">
      <a href={alternates.ca} hreflang="ca" lang="ca" data-astro-reload class:list={["no-underline hover:underline", lang === "ca" ? "!text-white" : "!text-mute"]}>Català</a>
      <span aria-hidden="true">·</span>
      <a href={alternates.es} hreflang="es" lang="es" data-astro-reload class:list={["no-underline hover:underline", lang === "es" ? "!text-white" : "!text-mute"]}>Castellano</a>
    </span>
  </nav>
</footer>

<!-- Escriptori: botó flotant de WhatsApp -->
<a id="wa-fab" href={negoci.whatsapp} target="_blank" rel="noopener" aria-label={t("comu.whatsapp.demanaCita")} class="group fixed bottom-7 right-7 z-40 hidden items-center gap-3 font-bold text-ink no-underline lg:flex">
  <span class="wa-lb pointer-events-none translate-x-2 bg-ink px-4 py-2.5 text-white opacity-0 shadow-lg transition duration-300 group-hover:translate-x-0 group-hover:opacity-100">{t("comu.whatsapp.demanaCita")}</span>
  <span class="wa-pulse relative grid size-[62px] place-items-center rounded-full bg-whatsapp shadow-[0_6px_20px_rgba(0,0,0,.22)] transition-transform group-hover:scale-105">
    <svg viewBox="0 0 24 24" class="size-[34px] fill-white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
  </span>
</a>

<!-- Mòbil: barra inferior fixa amb Truca + WhatsApp -->
<nav aria-label={t("comu.whatsapp.demanaCita")} class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-line bg-paper/95 p-2 pb-[max(.5rem,env(safe-area-inset-bottom))] shadow-[0_-6px_20px_rgba(20,20,20,.10)] backdrop-blur-[2px] lg:hidden">
  <a href={`tel:${negoci.telefon}`} aria-label={t("comu.whatsapp.barraTrucaAria")} class="flex min-h-14 items-center justify-center gap-2.5 bg-btn text-lg font-bold !text-white no-underline active:scale-[.98]">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
    {t("comu.whatsapp.barraTruca")}
  </a>
  <a href={negoci.whatsapp} target="_blank" rel="noopener" class="flex min-h-14 items-center justify-center gap-2.5 bg-whatsapp text-lg font-bold !text-ink no-underline active:scale-[.98]">
    <svg viewBox="0 0 24 24" class="size-6 fill-current" aria-hidden="true"><path d="M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0012.05 0zm0 21.785a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 5.45 0 9.884 4.434 9.881 9.892-.003 5.45-4.437 9.884-9.885 9.884z" /></svg>
    {t("comu.whatsapp.barraWhatsapp")}
  </a>
</nav>
